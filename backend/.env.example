# ============================================================
# PULPO.ai backend — environment variables
# ============================================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit .env (it is gitignored).
#
# In production (Droplet) every CHANGE_ME value MUST be regenerated.
# Do NOT reuse dev secrets in production.
# ============================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development                  # use 'production' on the Droplet
PORT=4000                             # host port the backend listens on

# --- Database --------------------------------------------------------------
# In docker-compose, host = service name. URL-encode special chars in password
# (e.g. '/' becomes %2F).
# Dev:  postgresql://pulpo:<pwd>@postgres:5432/pulpo_db
# Prod: postgresql://pulpo:<pwd>@postgres:5432/pulpo_prod
DATABASE_URL=postgresql://pulpo:CHANGE_ME@postgres:5432/pulpo_db

# Consumed by the postgres container (NOT by the Node app).
# These must be consistent with DATABASE_URL above.
POSTGRES_USER=pulpo
POSTGRES_PASSWORD=CHANGE_ME           # generate: openssl rand -base64 24
POSTGRES_DB=pulpo_db                  # use 'pulpo_prod' in production

# --- Auth (JWT) ------------------------------------------------------------
# Generate fresh in production. Do NOT reuse dev secrets.
JWT_SECRET=CHANGE_ME                  # generate: openssl rand -base64 32
JWT_REFRESH_SECRET=CHANGE_ME          # generate: openssl rand -base64 32 (must differ from JWT_SECRET)

# --- External APIs ---------------------------------------------------------
CLAUDE_API_KEY=sk-ant-api03-CHANGE_ME   # https://console.anthropic.com/settings/keys
FOOTBALL_DATA_API_KEY=CHANGE_ME         # https://www.football-data.org/client/register

# --- Rate limits -----------------------------------------------------------
ANON_MSG_LIMIT=5                      # daily messages for anonymous (no account) users
DAILY_MSG_LIMIT=30                    # daily messages for authenticated users

# --- Competition mode ------------------------------------------------------
# 'league_demo' (La Liga + Premier) or 'world_cup' (May 2026+)
COMPETITION_MODE=league_demo

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins. The native mobile app does not send
# an Origin header, so requests without Origin are allowed unconditionally.
# Dev example:  http://localhost:8081,http://192.168.0.35:8081
# Prod:         https://pulpo.white-systems.com
CORS_ORIGIN=http://localhost:8081

# --- Security --------------------------------------------------------------
# Keep DISABLED in production. Only enable temporarily to debug schema.
GRAPHQL_INTROSPECTION_ENABLED=false
