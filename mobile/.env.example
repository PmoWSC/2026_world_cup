# ============================================================
# PULPO.ai mobile — environment variables
# ============================================================
# Copy this file to mobile/.env and fill in values for your setup.
# NEVER commit .env (it is gitignored).
#
# IMPORTANT: variables prefixed with EXPO_PUBLIC_ are inlined into
# the JS bundle at build time and are PUBLIC. Do NOT put secrets here.
# ============================================================

# --- GraphQL endpoint ------------------------------------------------------
# iOS Simulator (same Mac as backend):     http://localhost:4000/graphql
# Physical device on same LAN as Mac:      http://<your-mac-lan-ip>:4000/graphql
# TestFlight / production:                 https://pulpo.white-systems.com/graphql
#
# Note: if you change LAN IP and the device cannot reach the backend, switch
# to localhost (simulator) or to the new LAN IP (physical device).
EXPO_PUBLIC_API_URL=http://localhost:4000/graphql

# --- Competition mode ------------------------------------------------------
# Must match backend's COMPETITION_MODE.
# 'league_demo' (La Liga + Premier) or 'world_cup' (May 2026+).
EXPO_PUBLIC_COMPETITION_MODE=league_demo

# --- Default UI language ---------------------------------------------------
# Initial language if the device locale is not one of the 6 supported langs.
# Supported: en, es, fr, pt, de, it. User can override in Settings.
EXPO_PUBLIC_DEFAULT_LANGUAGE=en
